# ==============================================================================
# TILEVISTA - MULTI-WORKSPACE ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database Connection (MySQL Dialect for Prisma)
# Replace with your actual database credentials
DATABASE_URL="mysql://tilevista_user:tilevista_secure_pass@localhost:3306/tilevista_db"

# JSON Web Token Secret
# Must be a long, secure, randomized string in production
JWT_SECRET="tilevista_jwt_development_secret_key_change_me_in_production"
JWT_EXPIRATION="24h"

# Point of Sale (POS) External Synchronization
# Mocks the endpoint authentication key
POS_SYNC_WEBHOOK_SECRET="tilevista_pos_sync_webhook_secret_key"

# Low Stock Restock Metric Limit
LOW_STOCK_THRESHOLD=10

# Mail Notification Service Mock Configurations
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="mock_user"
SMTP_PASS="mock_pass"
SMTP_FROM="noreply@tilevista.com"

# Point of Sale (OSPOS) API Integration Settings
OSPOS_API_BASE_URL="http://localhost/ospos/public/index.php/api/tilevista"
OSPOS_API_TOKEN="Bearer your_secret_ospos_token_here"
RESERVATION_TTL_HOURS=24

