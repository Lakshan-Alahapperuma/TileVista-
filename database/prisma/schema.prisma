generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_logs {
  log_id      String    @id @db.Char(36)
  admin_id    String    @db.Char(36)
  action_type String?   @db.VarChar(100)
  action      String?   @db.Text
  target_type String?   @db.VarChar(100)
  target_id   String?   @db.Char(36)
  old_value   String?   @db.LongText
  new_value   String?   @db.LongText
  created_at  DateTime? @default(now()) @db.DateTime(0)
  users       users     @relation(fields: [admin_id], references: [user_id], onUpdate: Restrict, map: "fk_admin_log_user")

  @@index([admin_id], map: "fk_admin_log_user")
}

model asset_sizes {
  size_id        String            @id @db.Char(36)
  asset_id       String            @unique(map: "asset_id") @db.Char(36)
  width          Decimal?          @db.Decimal(10, 2)
  height         Decimal?          @db.Decimal(10, 2)
  depth          Decimal?          @db.Decimal(10, 2)
  unit           asset_sizes_unit? @default(cm)
  product_assets product_assets    @relation(fields: [asset_id], references: [asset_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_size_asset")
}

model asset_transformations {
  transform_id   String         @id @db.Char(36)
  asset_id       String         @unique(map: "asset_id") @db.Char(36)
  scale_x        Decimal?       @default(1.00) @db.Decimal(10, 2)
  scale_y        Decimal?       @default(1.00) @db.Decimal(10, 2)
  scale_z        Decimal?       @default(1.00) @db.Decimal(10, 2)
  rotation_x     Decimal?       @default(0.00) @db.Decimal(10, 2)
  rotation_y     Decimal?       @default(0.00) @db.Decimal(10, 2)
  rotation_z     Decimal?       @default(0.00) @db.Decimal(10, 2)
  product_assets product_assets @relation(fields: [asset_id], references: [asset_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_transform_asset")
}

model cart_items {
  cart_item_id        String    @id @db.Char(36)
  cart_id             String    @db.Char(36)
  ospos_item_id       Int
  quantity            Int       @default(1)
  unit_price_snapshot Decimal   @db.Decimal(12, 2)
  created_at          DateTime? @default(now()) @db.DateTime(0)
  carts               carts     @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cart_item_cart")

  @@index([cart_id], map: "fk_cart_item_cart")
  @@index([ospos_item_id], map: "idx_cart_items_ospos")
}

model carts {
  cart_id    String        @id @db.Char(36)
  user_id    String?       @db.Char(36)
  session_id String?       @unique(map: "session_id") @db.VarChar(255)
  status     carts_status? @default(active)
  expires_at DateTime?     @db.DateTime(0)
  created_at DateTime?     @default(now()) @db.DateTime(0)
  updated_at DateTime?     @default(now()) @db.DateTime(0)
  cart_items cart_items[]
  users      users?        @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_cart_user")

  @@index([user_id], map: "fk_cart_user")
}

model design_elements {
  element_id   String       @id @db.Char(36)
  design_id    String       @db.Char(36)
  element_type String?      @db.VarChar(100)
  position_x   Decimal?     @db.Decimal(10, 2)
  position_y   Decimal?     @db.Decimal(10, 2)
  position_z   Decimal?     @db.Decimal(10, 2)
  width        Decimal?     @db.Decimal(10, 2)
  height       Decimal?     @db.Decimal(10, 2)
  depth        Decimal?     @db.Decimal(10, 2)
  room_designs room_designs @relation(fields: [design_id], references: [design_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_element_design")

  @@index([design_id], map: "fk_element_design")
}

model design_items {
  design_item_id String         @id @db.Char(36)
  design_id      String         @db.Char(36)
  product_id     String         @db.Char(36)
  asset_id       String         @db.Char(36)
  quantity       Int?           @default(1)
  position_x     Decimal?       @db.Decimal(10, 2)
  position_y     Decimal?       @db.Decimal(10, 2)
  position_z     Decimal?       @db.Decimal(10, 2)
  rotation_x     Decimal?       @default(0.00) @db.Decimal(10, 2)
  rotation_y     Decimal?       @default(0.00) @db.Decimal(10, 2)
  rotation_z     Decimal?       @default(0.00) @db.Decimal(10, 2)
  scale_x        Decimal?       @default(1.00) @db.Decimal(10, 2)
  scale_y        Decimal?       @default(1.00) @db.Decimal(10, 2)
  scale_z        Decimal?       @default(1.00) @db.Decimal(10, 2)
  created_at     DateTime?      @default(now()) @db.DateTime(0)
  updated_at     DateTime?      @default(now()) @db.DateTime(0)
  product_assets product_assets @relation(fields: [asset_id], references: [asset_id], onUpdate: Restrict, map: "fk_design_item_asset")
  room_designs   room_designs   @relation(fields: [design_id], references: [design_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_design_item_design")
  products       products       @relation(fields: [product_id], references: [product_id], onUpdate: Restrict, map: "fk_design_item_product")

  @@index([asset_id], map: "fk_design_item_asset")
  @@index([design_id], map: "fk_design_item_design")
  @@index([product_id], map: "fk_design_item_product")
}

model design_openings {
  opening_id   String                @id @db.Char(36)
  design_id    String                @db.Char(36)
  type         design_openings_type?
  style        String?               @db.VarChar(100)
  width        Decimal?              @db.Decimal(10, 2)
  height       Decimal?              @db.Decimal(10, 2)
  wall_id      String?               @db.Char(36)
  position_x   Decimal?              @db.Decimal(10, 2)
  position_y   Decimal?              @db.Decimal(10, 2)
  room_designs room_designs          @relation(fields: [design_id], references: [design_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_opening_design")
  design_walls design_walls?         @relation(fields: [wall_id], references: [wall_id], onUpdate: Restrict, map: "fk_opening_wall")

  @@index([design_id], map: "fk_opening_design")
  @@index([wall_id], map: "fk_opening_wall")
}

model design_walls {
  wall_id              String            @id @db.Char(36)
  design_id            String            @db.Char(36)
  wall_label           String?           @db.VarChar(50)
  wall_sequence        Int?
  wall_length          Decimal?          @db.Decimal(10, 2)
  wall_height          Decimal?          @db.Decimal(10, 2)
  wall_color           String?           @db.VarChar(50)
  tile_asset_id        String?           @db.Char(36)
  tile_texture_url     String?           @db.VarChar(500)
  tile_coverage_height Decimal?          @db.Decimal(10, 2)
  design_openings      design_openings[]
  product_assets       product_assets?   @relation(fields: [tile_asset_id], references: [asset_id], onDelete: Restrict, onUpdate: Restrict, map: "fk_wall_asset")
  room_designs         room_designs      @relation(fields: [design_id], references: [design_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wall_design")

  @@index([tile_asset_id], map: "fk_wall_asset")
  @@index([design_id], map: "fk_wall_design")
}

model inventory_reservations {
  reservation_id String                         @id @db.Char(36)
  order_id       String                         @db.Char(36)
  ospos_item_id  Int
  quantity       Int
  expires_at     DateTime?                      @db.DateTime(0)
  status         inventory_reservations_status? @default(active)
  orders         orders                         @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_reservation_order")

  @@index([order_id], map: "fk_reservation_order")
  @@index([ospos_item_id], map: "idx_reservations_ospos")
}

model notifications {
  notification_id String    @id @db.Char(36)
  user_id         String    @db.Char(36)
  title           String    @db.VarChar(255)
  message         String    @db.Text
  type            String?   @db.VarChar(50)
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_notification_user")

  @@index([user_id], map: "idx_notifications_user")
}

model order_items {
  order_item_id         String  @id @db.Char(36)
  order_id              String  @db.Char(36)
  ospos_item_id         Int
  product_name_snapshot String  @db.VarChar(255)
  quantity              Int
  unit_price            Decimal @db.Decimal(12, 2)
  subtotal              Decimal @db.Decimal(12, 2)
  orders                orders  @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_item_order")

  @@index([order_id], map: "fk_order_item_order")
  @@index([ospos_item_id], map: "idx_order_items_ospos")
}

model order_status_history {
  history_id String    @id @db.Char(36)
  order_id   String    @db.Char(36)
  status     String    @db.VarChar(50)
  changed_by String?   @db.Char(36)
  remarks    String?   @db.Text
  changed_at DateTime? @default(now()) @db.DateTime(0)
  orders     orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_history_order")
  users      users?    @relation(fields: [changed_by], references: [user_id], onUpdate: Restrict, map: "fk_history_user")

  @@index([order_id], map: "fk_history_order")
  @@index([changed_by], map: "fk_history_user")
}

model orders {
  order_id               String                   @id @db.Char(36)
  order_reference        String                   @unique(map: "order_reference") @db.VarChar(100)
  ospos_sale_id          Int?
  user_id                String                   @db.Char(36)
  design_id              String?                  @db.Char(36)
  total_amount           Decimal                  @db.Decimal(12, 2)
  status                 orders_status?           @default(pending)
  approval_type          orders_approval_type?    @default(auto)
  payment_status         orders_payment_status?   @default(pending)
  created_at             DateTime?                @default(now()) @db.DateTime(0)
  updated_at             DateTime?                @default(now()) @db.DateTime(0)
  confirmed_at           DateTime?                @db.DateTime(0)
  completed_at           DateTime?                @db.DateTime(0)
  inventory_reservations inventory_reservations[]
  order_items            order_items[]
  order_status_history   order_status_history[]
  room_designs           room_designs?            @relation(fields: [design_id], references: [design_id], onUpdate: Restrict, map: "fk_order_design")
  users                  users                    @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_order_user")

  @@index([design_id], map: "fk_order_design")
  @@index([user_id], map: "idx_orders_user")
}

model package_items {
  package_id String    @db.Char(36)
  product_id String    @db.Char(36)
  quantity   Int       @default(1)
  created_at DateTime? @default(now()) @db.DateTime(0)
  packages   packages  @relation(fields: [package_id], references: [package_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_package_item_package")
  products   products  @relation(fields: [product_id], references: [product_id], onUpdate: Restrict, map: "fk_package_item_product")

  @@id([package_id, product_id])
  @@index([product_id], map: "fk_package_item_product")
}

model packages {
  package_id          String           @id @db.Char(36)
  package_name        String           @db.VarChar(150)
  description         String?          @db.Text
  cover_image         String?          @db.VarChar(500)
  discount_percentage Decimal?         @default(0.00) @db.Decimal(5, 2)
  status              packages_status? @default(active)
  created_at          DateTime?        @default(now()) @db.DateTime(0)
  package_items       package_items[]
}

model product_asset_tags {
  asset_id       String         @db.Char(36)
  tag_id         String         @db.Char(36)
  product_assets product_assets @relation(fields: [asset_id], references: [asset_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_asset_tag_asset")
  tags           tags           @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_asset_tag_tag")

  @@id([asset_id, tag_id])
  @@index([tag_id], map: "fk_asset_tag_tag")
}

model product_assets {
  asset_id              String                 @id @db.Char(36)
  product_id            String                 @unique(map: "product_id") @db.Char(36)
  thumbnail_url         String?                @db.VarChar(500)
  image_url             String?                @db.VarChar(500)
  glb_url               String?                @db.VarChar(500)
  material_type         String?                @db.VarChar(100)
  color_family          String?                @db.VarChar(100)
  is_visible            Boolean?               @default(true)
  created_at            DateTime?              @default(now()) @db.DateTime(0)
  updated_at            DateTime?              @default(now()) @db.DateTime(0)
  asset_sizes           asset_sizes?
  asset_transformations asset_transformations?
  design_items          design_items[]
  design_walls          design_walls[]
  product_asset_tags    product_asset_tags[]
  products              products               @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_asset_product")
}

model products {
  product_id       String            @id @db.Char(36)
  ospos_item_id    Int               @unique(map: "ospos_item_id")
  is_active        Boolean?          @default(true)
  created_at       DateTime?         @default(now()) @db.DateTime(0)
  updated_at       DateTime?         @default(now()) @db.DateTime(0)
  design_items     design_items[]
  package_items    package_items[]
  product_assets   product_assets?
  stock_thresholds stock_thresholds?

  @@index([ospos_item_id], map: "idx_products_ospos")
}

model room_designs {
  design_id           String                    @id @db.Char(36)
  user_id             String                    @db.Char(36)
  design_name         String                    @db.VarChar(150)
  design_type         room_designs_design_type? @default(bathroom)
  room_shape          String?                   @db.VarChar(50)
  length              Decimal?                  @db.Decimal(10, 2)
  width               Decimal?                  @db.Decimal(10, 2)
  height              Decimal?                  @db.Decimal(10, 2)
  floor_texture_url   String?                   @db.VarChar(500)
  wall_texture_url    String?                   @db.VarChar(500)
  created_at          DateTime?                 @default(now()) @db.DateTime(0)
  updated_at          DateTime?                 @default(now()) @db.DateTime(0)
  design_elements     design_elements[]
  design_items        design_items[]
  custom_design_items custom_design_items[]
  design_openings     design_openings[]
  design_walls        design_walls[]
  orders              orders[]
  users               users                     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_design_user")
  room_vertices       room_vertices[]

  @@index([user_id], map: "idx_design_user")
}

model room_vertices {
  vertex_id      String       @id @db.Char(36)
  design_id      String       @db.Char(36)
  x              Decimal?     @db.Decimal(10, 2)
  y              Decimal?     @db.Decimal(10, 2)
  z              Decimal?     @db.Decimal(10, 2)
  sequence_order Int?
  created_at     DateTime?    @default(now()) @db.DateTime(0)
  room_designs   room_designs @relation(fields: [design_id], references: [design_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_vertex_design")

  @@index([design_id], map: "fk_vertex_design")
}

model stock_thresholds {
  threshold_id    String    @id @db.Char(36)
  product_id      String    @unique(map: "product_id") @db.Char(36)
  threshold_value Int
  created_at      DateTime? @default(now()) @db.DateTime(0)
  updated_at      DateTime? @default(now()) @db.DateTime(0)
  products        products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_threshold_product")
}

model tags {
  tag_id             String               @id @db.Char(36)
  tag_name           String               @unique(map: "tag_name") @db.VarChar(100)
  product_asset_tags product_asset_tags[]
}

model user_addresses {
  address_id    String                @id @db.Char(36)
  user_id       String                @db.Char(36)
  label         user_addresses_label? @default(home)
  address_line1 String                @db.VarChar(255)
  address_line2 String?               @db.VarChar(255)
  city          String?               @db.VarChar(100)
  district      String?               @db.VarChar(100)
  postal_code   String?               @db.VarChar(20)
  is_default    Boolean?              @default(false)
  created_at    DateTime?             @default(now()) @db.DateTime(0)
  users         users                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_address_user")

  @@index([user_id], map: "fk_address_user")
}

model users {
  user_id                 String                   @id @db.Char(36)
  first_name              String                   @db.VarChar(100)
  last_name               String                   @db.VarChar(100)
  email                   String                   @unique(map: "email") @db.VarChar(150)
  phone                   String?                  @db.VarChar(20)
  password_hash           String                   @db.VarChar(255)
  role                    users_role               @default(customer)
  status                  users_status             @default(active)
  created_at              DateTime?                @default(now()) @db.DateTime(0)
  updated_at              DateTime?                @default(now()) @db.DateTime(0)
  admin_logs              admin_logs[]
  carts                   carts[]
  notifications           notifications[]
  order_status_history    order_status_history[]
  orders                  orders[]
  room_designs            room_designs[]
  user_addresses          user_addresses[]
  modelGenerationProjects ModelGenerationProject[]
}

enum design_openings_type {
  door
  window
}

enum user_addresses_label {
  home
  office
  other
}

enum carts_status {
  active
  abandoned
  converted
}

enum room_designs_design_type {
  room
  bathroom
}

enum asset_sizes_unit {
  cm
  m
}

enum inventory_reservations_status {
  active
  released
  expired
  completed
}

enum orders_status {
  pending
  approved
  rejected
  completed
  cancelled
}

enum packages_status {
  active
  inactive
}

enum orders_approval_type {
  auto
  manual
}

enum users_role {
  customer
  admin
}

enum orders_payment_status {
  pending
  paid
}

enum users_status {
  active
  inactive
}

model custom_design_items {
  custom_item_id String       @id @db.Char(36)
  design_id      String       @db.Char(36)
  item_type      String       @db.VarChar(100)
  item_name      String?      @db.VarChar(150)
  model_url      String?      @db.VarChar(500)
  position_x     Decimal?     @db.Decimal(10, 2)
  position_y     Decimal?     @db.Decimal(10, 2)
  position_z     Decimal?     @db.Decimal(10, 2)
  rotation_y     Decimal?     @default(0.00) @db.Decimal(10, 2)
  created_at     DateTime?    @default(now()) @db.DateTime(0)
  room_designs   room_designs @relation(fields: [design_id], references: [design_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_custom_item_design")

  @@index([design_id], map: "fk_custom_item_design")
}

enum inquiries_status {
  pending
  replied
}

model inquiries {
  inquiry_id String           @id @db.Char(36)
  name       String           @db.VarChar(150)
  email      String           @db.VarChar(150)
  subject    String?          @db.VarChar(255)
  message    String           @db.Text
  status     inquiries_status @default(pending)
  created_at DateTime?        @default(now()) @db.DateTime(0)
  updated_at DateTime?        @default(now()) @db.DateTime(0)
}

enum ModelGenerationStatus {
  UPLOADED
  QUEUED
  EXTRACTING_FRAMES
  RECONSTRUCTING
  GENERATING_MESH
  TEXTURING
  EXPORTING_GLB
  COMPLETED
  FAILED
  CANCELLED
}

enum ModelInputType {
  VIDEO
  IMAGES
}

model ModelGenerationProject {
  id                  String                @id @default(cuid())
  userId              String                @db.Char(36)
  name                String
  description         String?               @db.Text
  inputType           ModelInputType
  status              ModelGenerationStatus @default(UPLOADED)
  progress            Int                   @default(0)
  currentStep         String?
  inputVideoPath      String?
  outputGlbPath       String?
  thumbnailPath       String?
  errorMessage        String?               @db.Text
  fileSize            BigInt?
  processingStartedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user   users                  @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  images ModelGenerationImage[]

  @@index([userId])
  @@index([status])
  @@map("model_generation_projects")
}

model ModelGenerationImage {
  id           String   @id @default(cuid())
  projectId    String
  filePath     String
  originalName String?
  orderNumber  Int?
  createdAt    DateTime @default(now())

  project ModelGenerationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("model_generation_images")
}
